# ==============================================================
# URL Safety Checker - Environment Configuration
# ==============================================================

# Backend Port
PORT=5000

# Node Environment: development, test, production
NODE_ENV=development

# MongoDB Connection String
# If MongoDB is running locally, use mongodb://127.0.0.1:27017/url_safety_checker
# If MongoDB is not running, the application automatically uses an embedded/local store fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/url_safety_checker

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
