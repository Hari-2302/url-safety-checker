# ==============================================================
# URL Safety Checker - Environment Configuration
# ==============================================================

# Backend Port
PORT=5000

# Node Environment: development, test, production
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/url_safety_checker
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.ug1wfgq.mongodb.net/url_safety_checker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ug1wfgq.mongodb.net/url_safety_checker?retryWrites=true&w=majority

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
